{
  "name": "solar-system-sim",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 4317",
    "test:visual": "playwright test --config playwright.config.ts",
    "test:visual:update": "npm run test:visual -- --update-snapshots",
    "validate:horizons": "node scripts/validate-horizons-trajectories.mjs",
    "validate:trajectory-registry": "npx esbuild scripts/validate-trajectory-registry.ts --bundle --format=esm --platform=node --outfile=.tmp-validate-trajectory-registry.mjs && node .tmp-validate-trajectory-registry.mjs && rm .tmp-validate-trajectory-registry.mjs",
    "validate:lod": "npx esbuild scripts/validate-screen-space-lod.ts --bundle --format=esm --platform=node --outfile=.tmp-validate-lod.mjs && node .tmp-validate-lod.mjs && rm .tmp-validate-lod.mjs",
    "validate:trajectory-semantics": "npx esbuild scripts/validate-trajectory-semantics.ts --bundle --format=esm --platform=node --outfile=.tmp-validate-trajectory-semantics.mjs && node .tmp-validate-trajectory-semantics.mjs && rm .tmp-validate-trajectory-semantics.mjs",
    "validate:ephemeris": "npx esbuild scripts/validate-ephemeris.ts --bundle --format=esm --platform=node --outfile=.tmp-validate-ephemeris.mjs && node .tmp-validate-ephemeris.mjs && rm .tmp-validate-ephemeris.mjs",
    "validate:data": "npm run validate:horizons && npm run validate:trajectory-registry && npm run validate:lod && npm run validate:trajectory-semantics && npm run validate:ephemeris",
    "validate:pages": "node scripts/validate-cloudflare-assets.mjs",
    "build:pages": "npm run build && npm run validate:pages",
    "verify": "npm run lint && npm run build:pages && npm run validate:data && npm run test:visual"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
